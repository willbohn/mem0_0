# Copy to ~/.config/mem0_0-arch/deployment.env with mode 0600.
# Every image must use an immutable registry digest; tags alone are rejected by policy.
MEM0_0_SOURCE_REVISION=<40-character candidate Git revision>
MEM0_0_SOURCE_TREE_SHA256=<64-character candidate source-tree SHA-256>
MEM0_0_PYTHON_IMAGE=python:3.12-slim@sha256:<digest>
MEM0_0_PGVECTOR_IMAGE=docker.io/pgvector/pgvector:pg17@sha256:<digest>
