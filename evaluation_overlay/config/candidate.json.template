{
  "version": "v1.1",
  "recall": {"mode": "state_aware"},
  "llm": {
    "provider": "openai",
    "config": {
      "api_key": "${MEM0_BENCH_LOCAL_API_KEY}",
      "model": "prism-ml/Bonsai-27B-gguf",
      "max_tokens": 1024,
      "openai_base_url": "${MEM0_BENCH_LLM_BASE_URL}",
      "temperature": 0
    }
  },
  "embedder": {
    "provider": "openai",
    "config": {
      "api_key": "${MEM0_BENCH_LOCAL_API_KEY}",
      "embedding_dims": 1024,
      "model": "BAAI/bge-m3",
      "openai_base_url": "${MEM0_BENCH_EMBED_BASE_URL}"
    }
  }
}
